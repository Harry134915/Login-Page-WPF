<Window x:Class="Login_Pape.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Login_Pape.ViewModels"
        xmlns:helper="clr-namespace:Login_Pape.Helpers"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Height="500"
        Width="800">

    <!-- ViewModel -->
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Background="Transparent" MouseLeftButtonDown="Window_MouseLeftButtonDown">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="1.5*" />
        </Grid.ColumnDefinitions>

        <!-- 关闭 -->
        <Button Grid.Column="1"
                Panel.ZIndex="1"
                Command="{Binding CloseCommand}"
                Style="{StaticResource imgClose}">
            <Image Source="/Images/close1.jpg"/>
        </Button>

        <!-- 最小化 -->
        <Button Grid.Column="1"
                Panel.ZIndex="1"
                Command="{Binding MinimizeCommand}"
                Style="{StaticResource imgMinimize}">
            <Image Source="/Images/minimize1.jpg"/>
        </Button>

        <!-- 左侧 -->
        <Border CornerRadius="10 0 0 10">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#3AA9AD" Offset="0" />
                    <GradientStop Color="#3AADA1" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <Canvas>
                    <Polygon Points="0,20 230,140 0,270" Fill="#4EB1B6" />
                    <Polygon Points="100,400 200,370 180,470" Fill="#4EB1B6" />
                    <Ellipse Margin="250 450 0 0" Width="40" Height="40" Fill="#4EB1B6" />
                    <Ellipse Margin="50 400 0 0" Width="20" Height="20" Fill="#4EB1B6" />
                </Canvas>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Sign Up" Style="{StaticResource TitleText}" />
                    <TextBlock Text="Enter your personal info and create new account to connect us"
                               Margin="20 30"
                               Opacity="0.8"
                               Style="{StaticResource NormalText}" />
                    <Button Content="Sign Up" Style="{StaticResource button}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 右侧 -->
        <Border Grid.Column="1"
                Background="White"
                CornerRadius="0 10 10 0">

            <StackPanel VerticalAlignment="Center">

                <TextBlock Text="登        录"
                           Foreground="#3AB19B"
                           Style="{StaticResource TitleText}" />

                <!-- 第三方 -->
                <StackPanel Orientation="Horizontal"
                            Margin="0 20"
                            HorizontalAlignment="Center">
                    <Button Style="{StaticResource buttonCircle}">
                        <Image Source="/Images/qq.png" Width="20" Height="20"/>
                    </Button>
                    <Button Style="{StaticResource buttonCircle}">
                        <Image Source="/Images/wechat.png" Width="20" Height="20"/>
                    </Button>
                    <Button Style="{StaticResource buttonCircle}">
                        <Image Source="/Images/google.png" Width="20" Height="20"/>
                    </Button>
                </StackPanel>

                <TextBlock Text="or use your email info :"
                           Margin="0 10 0 15"
                           Foreground="#878787"
                           Style="{StaticResource NormalText}" />

                <!-- Email -->
                <Border BorderBrush="#ACB0AF"
                        BorderThickness="1"
                        Margin="70 7"
                        CornerRadius="5">
                    <Grid Margin="7 9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Image Source="/Images/Email.png" Height="20"/>

                        <Grid Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text=" Email"
                       Style="{StaticResource textHint}"
                       IsHitTestVisible="False"
                       VerticalAlignment="Center"
                       Visibility="{Binding Email, Converter={StaticResource EmptyToVisibilityConverter}}"/>
                            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" 
                     Style="{StaticResource textBox}"
                     helper:FocusHelper.IsFocused="{Binding IsEmailFocused}"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Password -->
                <Border BorderBrush="#ACB0AF"
                        BorderThickness="1"
                        Margin="70 7"
                        CornerRadius="5">
                    <Grid Margin="7 9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Image Source="/Images/Lock.png" Height="20"/>

                        <Grid Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text=" Password"
                                       Style="{StaticResource textHint}"
                                       IsHitTestVisible="False"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding Password,
                                           Converter={StaticResource EmptyToVisibilityConverter}}"/>

                            <PasswordBox Style="{StaticResource textBox}"
                                         helper:PasswordBoxHelper.BoundPassword="{Binding Password, Mode=TwoWay}" 
                                         helper:FocusHelper.IsFocused="{Binding IsPasswordFocused}"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 登录 -->
                <Button Content="Sign In"
                        Command="{Binding LoginCommand}"
                        Style="{StaticResource mainButton}" />

            </StackPanel>
        </Border>
    </Grid>

</Window>
